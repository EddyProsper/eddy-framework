<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
    version="4.0">
    <display-name>Eddy Demo</display-name>

    <servlet>
        <servlet-name>front-controller</servlet-name>
        <servlet-class>mg.eddy.servlet.FrontController</servlet-class>
        <init-param>
            <param-name>CONTROLLER_PACKAGE</param-name>
            <param-value>mg.eddy.demo.controller</param-value>
        </init-param>
        <init-param>
            <param-name>VIEW_PATH</param-name>
            <param-value>/WEB-INF/views</param-value>
        </init-param>
        <init-param>
            <param-name>VIEW_EXTENSIONS</param-name>
            <param-value>jsp,html</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>front-controller</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>
</web-app>
